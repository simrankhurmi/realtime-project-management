# ─── Backend Integration ───────────────────────────────────────────
# Server-side URL used by Next.js to proxy /api/* → backend
BACKEND_URL=http://localhost:3000

# Public backend URL (browser + Socket.io)
NEXT_PUBLIC_BACKEND_URL=http://localhost:3000

# API base — keep as /api/v1 to use Next.js proxy (recommended)
# Or set full URL e.g. http://localhost:3000/api/v1 for direct calls
NEXT_PUBLIC_API_URL=/api/v1

# Socket.io server (same host as backend)
NEXT_PUBLIC_SOCKET_URL=http://localhost:3000

# Frontend URL — must match backend CORS_ORIGIN
NEXT_PUBLIC_APP_URL=http://localhost:5173
